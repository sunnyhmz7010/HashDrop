[Unit]
Description=HashDrop automatic delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hashdrop
Group=hashdrop
WorkingDirectory=/var/lib/hashdrop
ExecStart=/usr/local/bin/hashdrop -config /etc/hashdrop/config.json -data-dir /var/lib/hashdrop -listen 0.0.0.0:8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hashdrop /etc/hashdrop
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
