[Unit]
Description=TinyFaka automatic delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tinyfaka
Group=tinyfaka
WorkingDirectory=/var/lib/tinyfaka
ExecStart=/usr/local/bin/tinyfaka -config /etc/tinyfaka/config.json -data-dir /var/lib/tinyfaka -listen 0.0.0.0:8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tinyfaka /etc/tinyfaka
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
